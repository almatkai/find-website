{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "find-website",
  "title": "Find Website",
  "description": "Quickly find the website you are looking for.",
  "icon": "assets/logo.png",
  "author": "almatkai",
  "contributors": [
    "ridemountainpig"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "find",
      "title": "Find Website",
      "description": "Quickly find the website you are looking for.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "browser",
      "title": "Browser",
      "description": "Select your browser",
      "type": "dropdown",
      "required": true,
      "default": "chrome",
      "data": [
        {
          "title": "Google Chrome",
          "value": "chrome"
        },
        {
          "title": "Orion",
          "value": "orion"
        },
        {
          "title": "Arc",
          "value": "arc"
        },
        {
          "title": "Safari",
          "value": "safari"
        },
        {
          "title": "Firefox",
          "value": "firefox"
        },
        {
          "title": "Zen Browser",
          "value": "zen"
        },
        {
          "title": "Brave Browser",
          "value": "brave"
        },
        {
          "title": "Vivaldi",
          "value": "vivaldi"
        },
        {
          "title": "Opera",
          "value": "opera"
        },
        {
          "title": "Microsoft Edge",
          "value": "edge"
        }
      ]
    },
    {
      "name": "profile",
      "title": "Profile Directory",
      "description": "(Google Chrome only) Directory where your profile's data is saved.",
      "type": "textfield",
      "required": true,
      "default": "Default"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "ini": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.find-website",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/find-website",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/find-website",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
